# Copy to .env for local runs. All optional.

EWC_PORT=8080
EWC_HOST=0.0.0.0
EWC_DATA_DIR=./data
# EWC_DB_PATH=./data/ewc.sqlite
# EWC_WEB_DIR=./packages/web/dist       # set in production to serve the built UI

EWC_LOG_LEVEL=info                       # debug | info | warn | error
EWC_HEALTH_POLL_MS=15000
EWC_WLED_TIMEOUT_MS=5000
EWC_WLED_BULK_RETRIES=15                 # retries for truncated /json/fxdata and /json/cfg
